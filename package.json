{
  "name": "talkar-clinic-emr",
  "version": "1.0.0",
  "type": "module",
  "description": "Multi-tenant Clinic EMR, Doctor OPD Queue Flowboard, and Voice AI Medical Concierge Platform for Talkar",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && (mkdir -p dist/ui && cp -r src/ui/* dist/ui/)",
    "start": "tsx src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "setup": "npm run prisma:generate && npm run prisma:push && npm run prisma:seed",
    "test": "bash scripts/test_api.sh"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "prisma": "^5.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
